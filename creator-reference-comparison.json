  "derivedCadenceGuidance": {
    "standardEditorialUnitSeconds": {
      "workingRange": [
        6,
        15
      ],
      "basis": "The exact-subject and two cross-topic references cluster near 6-second lower quartiles, 9-second medians, and 12-15-second upper quartiles."
    },
    "progressiveDataSceneSeconds": {
      "workingRange": [
        14.5,
        28
      ],
      "basis": "The adjacent-subject data-story reference uses fewer but longer coherent scenes while advancing internal callouts and state changes."
    },
    "rule": "Durations are descriptive starting ranges, never hard limits. Split or extend according to narration-job boundaries, readability, and phrase-aligned events. A long scene remains active only when internal visual progression continues."
  },
  "reusableNarrationVisualPatterns": [
    {
      "id": "identity_and_status_intro",
      "narrationTrigger": "Introduce one entity and establish identity, role, or status.",
      "mediaRequirement": "Verified portrait/cutout or direct footage of the named entity; identity label when needed.",
      "eligibleTreatments": [
        "portrait_or_cutout",
        "archival_footage",
        "single_image_hold",
        "montage_gallery_or_carousel"
      ],
      "timingRule": "Entity recognition and label must arrive with the spoken name or status phrase."
    },
    {
      "id": "factual_claim_with_receipt",
      "narrationTrigger": "A factual, disputed, quoted, sourced, or otherwise evidentiary claim.",
      "mediaRequirement": "Exact document, screenshot, article, chart, post, interview, or event footage when available.",
      "eligibleTreatments": [
        "evidence_or_document",
        "interview_footage",
        "archival_footage",
        "custom_motion_graphic"
      ],
      "timingRule": "The decisive line, value, or testimony becomes legible when the relevant words are spoken."
    },
    {
      "id": "relationship_or_shared_event",
      "narrationTrigger": "Two people, organizations, or objects are linked by a relationship or shared event.",
      "mediaRequirement": "Exact joint footage or several verified images of the pair; separate portraits only when no joint asset exists.",
      "eligibleTreatments": [
        "montage_gallery_or_carousel",
        "archival_footage",
        "portrait_or_cutout"
      ],
      "timingRule": "Both entities must be visible by the phrase that establishes the relationship."
    },
    {
      "id": "numeric_benchmark_or_outlier",
      "narrationTrigger": "A rank, ratio, benchmark, distribution, comparison, accumulation, or outlier claim.",
      "mediaRequirement": "Verified values, labels, comparison set, and subject imagery only when it aids identification.",
      "eligibleTreatments": [
        "infographic",
        "counter_or_numeric",
        "custom_motion_graphic",
        "spatial_or_cinematic_3d"
      ],
      "timingRule": "Build the comparison before emphasizing the conclusion; reveal the winning value on its spoken phrase."
    },
    {
      "id": "chronology_or_progression",
      "narrationTrigger": "A sequence of dated events, stages, releases, roles, or changes over time.",
      "mediaRequirement": "Chronologically verified assets and explicit time anchors.",
      "eligibleTreatments": [
        "montage_gallery_or_carousel",
        "archival_footage",
        "after_effects_scene",
        "custom_motion_graphic"
      ],
      "timingRule": "Each stage changes when narration advances; silent years or stages accelerate."
    },
    {
      "id": "contrast_reversal_or_reality_check",
      "narrationTrigger": "The narration overturns an assumption, contrasts eras, or challenges a quote/claim.",
      "mediaRequirement": "Distinct assets for both sides; proof for the corrective side when it is factual.",
      "eligibleTreatments": [
        "archival_footage",
        "custom_motion_graphic",
        "montage_gallery_or_carousel",
        "evidence_or_document"
      ],
      "timingRule": "Show the setup first and make the visual reversal land with the pivot word or corrective phrase."
    },
    {
      "id": "scale_or_escalation",
      "narrationTrigger": "Growth, decline, accumulation, widening reach, rising stakes, or repeated examples.",
      "mediaRequirement": "Enough verified examples or values to make the change visible.",
      "eligibleTreatments": [
        "counter_or_numeric",
        "infographic",
        "montage_gallery_or_carousel",
        "custom_motion_graphic",
        "direct_broll"
      ],
      "timingRule": "Visual density or magnitude progresses with narration rather than appearing fully formed."
    },
    {
      "id": "presenter_or_broll_reset",
      "narrationTrigger": "Synthesis, question, transition, emotional pause, or section reset without a new proof obligation.",
      "mediaRequirement": "Presenter, atmospheric direct footage, or a clean subject hold tied to the current topic.",
      "eligibleTreatments": [
        "interview_footage",
        "direct_broll",
        "single_image_hold"
      ],
      "timingRule": "Use as a deliberate breathing point; do not let it replace required evidence."
    }
  ],
  "selectorOrder": [
    "Determine the passage's narration job and single viewer takeaway.",
    "Determine claim type and evidence obligation.",
    "Determine exact entities, relationships, values, dates, and source specificity.",
    "Define required media independently of presentation/template choice.",
    "Define phrase-aligned visual events and available duration.",
    "Retrieve eligible direct-media, infographic, spatial, AE-template, and custom-generation candidates.",
    "Reject candidates whose important visual events cannot align with the spoken phrases.",
    "Score remaining candidates for semantic coverage, media-slot fit, timing fit, readability, style, and adjustment cost.",
    "Select the highest-confidence candidate or flag the exact missing capability for the user."
  ],
  "hardGates": [
    "A required named entity, relationship, value, date, or proof role is absent.",
    "An important visual event cannot be aligned to its motivating spoken phrase.",
    "The template's slots, framing, transition, or duration cannot be safely adjusted to the required media.",
    "A decorative or representative asset is being used as proof for an exact factual claim."
  ],
  "flagsNotAutomaticRejections": [
    "The best semantic option conflicts with the dark cinematic system and no comparable styled option exists.",
    "A template requires supported speed, text, or color adjustment.",
    "A needed asset or template family must be sourced or built.",
    "Continuity differs from the preceding scene but a suitable transition can bridge it."
  ]
}
