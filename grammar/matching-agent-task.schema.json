{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matching-agent-task@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "objectiveId", "owner", "requestedBy", "storyPackage", "entityRoster", "templateCatalog", "output", "dependencyReceiptIds", "dependencyReceipts", "profile", "toolAllowList", "mutationScope", "acceptanceChecks", "timeoutClass", "retryClass", "userInput", "selectionAuthorized", "renderingAuthorized"],
  "properties": {
    "schemaVersion": {"const": "matching-agent-task@1"},
    "taskId": {"type": "string", "minLength": 1},
    "objectiveId": {"type": "string", "minLength": 1},
    "owner": {"const": "matching"},
    "requestedBy": {"type": "string", "minLength": 1},
    "storyPackage": {"$ref": "#/$defs/storyPackage"},
    "entityRoster": {"$ref": "#/$defs/authority"},
    "templateCatalog": {"$ref": "#/$defs/catalog"},
    "dataHandoff": {"$ref": "#/$defs/fileInput"},
    "mediaHandoff": {"$ref": "#/$defs/fileInput"},
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "directory"],
      "properties": {"schema": {"const": "matching-agent-receipt@1"}, "directory": {"type": "string", "minLength": 1}}
    },
    "dependencyReceiptIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "dependencyReceipts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "promptVersion", "toolPolicy", "permissionPolicy", "evaluationProfile"],
      "properties": {
        "profileId": {"type": "string", "minLength": 1},
        "promptVersion": {"const": "matching-agent-prompt@1"},
        "toolPolicy": {"const": "matching-tools@1"},
        "permissionPolicy": {"const": "matching-review-only@1"},
        "evaluationProfile": {"const": "matching-cross-story@1"}
      }
    },
    "toolAllowList": {"type": "array", "items": {"enum": ["read_matching_artifacts"]}, "uniqueItems": true},
    "mutationScope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "acceptanceChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "timeoutClass": {"enum": ["short", "standard", "long"]},
    "retryClass": {"enum": ["none", "transient_once"]},
    "userInput": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed", "required"],
      "properties": {"allowed": {"type": "boolean"}, "required": {"type": "boolean"}}
    },
    "selectionAuthorized": {"const": false},
    "renderingAuthorized": {"const": false}
  },
  "$defs": {
    "fileInput": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "repositoryRoot", "repositoryCommit", "path", "sha256", "version"],
      "properties": {
        "repositoryId": {"type": "string", "minLength": 1}, "repositoryRoot": {"type": "string", "minLength": 1},
        "repositoryCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version": {"type": "string", "minLength": 1}
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "repositoryRoot", "repositoryCommit", "path", "sha256", "identity"],
      "properties": {
        "repositoryId": {"type": "string", "minLength": 1}, "repositoryRoot": {"type": "string", "minLength": 1},
        "repositoryCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identity": {"type": "string", "minLength": 1}
      }
    },
    "storyPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["repositoryId", "repositoryRoot", "repositoryCommit", "path", "sha256", "authorityRoot", "authorityCommit", "checkerPython"],
      "properties": {
        "repositoryId": {"type": "string", "minLength": 1}, "repositoryRoot": {"type": "string", "minLength": 1},
        "repositoryCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "authorityRoot": {"type": "string", "minLength": 1},
        "authorityCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "checkerPython": {"type": "string", "minLength": 1}
      }
    }
  }
}
